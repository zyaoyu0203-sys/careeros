# Copy to .env.local for development. Without the Supabase values the app runs in
# single-user local mode (data in .data/db.json) — never deploy without them.

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Lets the scheduled search read every user's preferences.
SUPABASE_SERVICE_ROLE_KEY=

# AI — job scoring, resume tailoring, cover letters, resume import. Set one provider.
# DeepSeek, or an OpenAI-compatible host for it (e.g. Volcengine Ark: https://ark.cn-beijing.volces.com/api/v3
# with DEEPSEEK_MODEL set to your Ark model or endpoint id). Takes precedence when set.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Or Claude
ANTHROPIC_API_KEY=

# SerpAPI — Google Jobs search (JobsDB, Indeed, LinkedIn listings). Optional.
SERPAPI_API_KEY=

# Protects /api/cron/discover. Vercel Cron sends it automatically when set.
CRON_SECRET=

# Optional: used in sign-up confirmation links when the request has no Origin header.
NEXT_PUBLIC_SITE_URL=
